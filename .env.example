# ---- Provider API Keys ----
# Uncomment and fill in the keys for the providers you want to use.

# Groq (https://console.groq.com)
# GROQ_API_KEY=gsk_your_key_here

# OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=sk-your_key_here

# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Google Gemini (https://aistudio.google.com)
# GEMINI_API_KEY=AIzaSyour_key_here

# Mistral (https://console.mistral.ai)
# MISTRAL_API_KEY=your_key_here

# Cohere (https://dashboard.cohere.com)
# COHERE_API_KEY=your_key_here

# DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=sk-your_key_here

# OpenRouter (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-your_key_here

# SambaNova (https://cloud.sambanova.ai)
# SAMBANOVA_API_KEY=your_key_here

# Cerebras (https://cloud.cerebras.ai)
# CEREBRAS_API_KEY=csk-your_key_here

# Together AI (https://api.together.ai)
# TOGETHER_API_KEY=your_key_here

# Fireworks AI (https://fireworks.ai)
# FIREWORKS_API_KEY=fw_your_key_here

# Xiaomi MiMo
# MIMO_API_KEY=your_key_here

# LM Studio (optional, for secured hosts)
# LMSTUDIO_API_KEY=your_key_here

# Ollama (optional, for secured hosts)
# OLLAMA_API_KEY=your_key_here

# ---- Optional ----
# Hugging Face Inference Providers
# HF_TOKEN=your_key_here

# DeepInfra
# DEEPINFRA_API_KEY=your_key_here

# Alibaba Cloud Model Studio, use the matching regional endpoint
# DASHSCOPE_API_KEY=your_key_here

# Used by examples/openrouter_multimodal_agent.py
# OPENROUTER_MULTIMODAL_MODEL=google/gemini-2.5-flash

# Used by SQL session store examples
# MTP_POSTGRES_DB_URL=postgresql://user:pass@localhost:5432/mtp
# MTP_MYSQL_HOST=localhost
# MTP_MYSQL_PORT=3306
# MTP_MYSQL_USER=root
# MTP_MYSQL_PASSWORD=secret
# MTP_MYSQL_DATABASE=mtp
